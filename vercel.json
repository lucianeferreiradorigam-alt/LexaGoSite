{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicos/amazon-ads",
      "destination": "/amazon-ads-para-livros",
      "permanent": true
    },
    {
      "source": "/amazon-ads",
      "destination": "/amazon-ads-para-livros",
      "permanent": true
    },
    {
      "source": "/ebooks",
      "destination": "/conversao-de-livros-em-ebook",
      "permanent": true
    },
    {
      "source": "/e-books",
      "destination": "/conversao-de-livros-em-ebook",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/conteudos",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/conteudos/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/lp/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
